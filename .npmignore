# Note: package.json "files" field takes precedence and is the real allow-list.
# It publishes dist/, README.md, LICENSE and CHANGELOG.md. This file is a
# belt-and-braces fallback for anything that field would otherwise let through.

# Source TypeScript files (compiled to dist/)
src/

# Test files
test/
*.test.ts
vitest.config.ts
coverage/
.nyc_output/

# Config files
tsconfig.json

# Development files
.env
.env.*

# Output directories
datasets/

# Logs
*.log
logs/

# OS files
.DS_Store
Thumbs.db

# IDE files
.vscode/
.idea/
*.swp
*.swo
*~

# Git files
.git/
.gitignore
.gitattributes
.github/

# Documentation (README.md, LICENSE and CHANGELOG.md ship via package.json files)
docs/
CLAUDE.md
scripts/

# Dependencies (never published)
node_modules/
