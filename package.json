{
  "name": "bfl-api",
  "version": "2.0.2",
  "description": "Black Forest Labs API wrapper - FLUX.1, FLUX.2, Kontext, FLUX Tools and FLUX 3 video generation for Node.js with CLI",
  "main": "dist/api.js",
  "types": "dist/api.d.ts",
  "type": "module",
  "bin": {
    "bfl": "dist/cli.js"
  },
  "exports": {
    ".": {
      "import": "./dist/api.js",
      "types": "./dist/api.d.ts"
    },
    "./api": {
      "import": "./dist/api.js",
      "types": "./dist/api.d.ts"
    },
    "./utils": {
      "import": "./dist/utils.js",
      "types": "./dist/utils.d.ts"
    },
    "./config": {
      "import": "./dist/config.js",
      "types": "./dist/config.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/cli.ts",
    "bfl": "tsx src/cli.ts",
    "bfl:help": "tsx src/cli.ts --help",
    "bfl:examples": "tsx src/cli.ts --examples",
    "bfl:credits": "tsx src/cli.ts --credits",
    "bfl:dev": "tsx src/cli.ts --flux-dev",
    "bfl:pro": "tsx src/cli.ts --flux-pro",
    "bfl:ultra": "tsx src/cli.ts --flux-ultra",
    "bfl:fill": "tsx src/cli.ts --flux-fill",
    "bfl:expand": "tsx src/cli.ts --flux-expand",
    "bfl:kontext-pro": "tsx src/cli.ts --kontext-pro",
    "bfl:kontext-max": "tsx src/cli.ts --kontext-max",
    "bfl:flux-2-pro": "tsx src/cli.ts --flux-2-pro",
    "bfl:flux-2-max": "tsx src/cli.ts --flux-2-max",
    "bfl:video": "tsx src/cli.ts --flux-3-video",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "check:spec": "tsx scripts/check-spec-drift.ts",
    "check:spec:snapshot": "tsx scripts/check-spec-drift.ts --snapshot docs/openapi-snapshot-2026-09-20.json",
    "check:spec:control": "tsx scripts/check-spec-drift.ts --control",
    "verify": "npm run build && npm run check:spec:control && npm run check:spec && npm test",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "bfl",
    "black-forest-labs",
    "flux",
    "flux-dev",
    "flux-pro",
    "flux-ultra",
    "kontext",
    "image-generation",
    "ai-image",
    "text-to-image",
    "image-to-image",
    "cli",
    "typescript",
    "flux-2",
    "flux-3",
    "klein",
    "video-generation",
    "text-to-video",
    "image-to-video",
    "video-edit",
    "video-upscale",
    "inpainting",
    "outpainting",
    "virtual-try-on",
    "deblur"
  ],
  "author": "img-gen Contributors",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aself101/bfl-api.git"
  },
  "bugs": {
    "url": "https://github.com/aself101/bfl-api/issues"
  },
  "homepage": "https://github.com/aself101/bfl-api#readme",
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "commander": "^11.1.0",
    "dotenv": "^16.3.1",
    "undici": "^7.29.1",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@vitest/coverage-v8": "^4.0.10",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.10"
  }
}
